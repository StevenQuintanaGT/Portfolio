---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { languages, useTranslations, type Lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />
    <meta name="theme-color" content="#282c34" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      Object.keys(languages).map((l) => (
        <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l)} />
      ))
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Inter:wght@400;500&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
