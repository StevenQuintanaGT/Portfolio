---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { site } from '../config';
import { languages, useTranslations, type Lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  lang: Lang;
  // Defaults to the home page title and description
  title?: string;
  description?: string;
  // Path of the preferred URL for this content (defaults to the current page)
  canonical?: string;
  // Path of this page in each language (defaults to the home pages)
  alternates?: Partial<Record<Lang, string>>;
  ogType?: 'website' | 'article';
  // Preview image path, from src/pages/og (defaults to the home card)
  ogImage?: string;
  // Language of the main content, when it differs from the interface (blog posts)
  contentLang?: Lang;
  published?: Date;
  modified?: Date;
  tags?: string[];
}

const {
  lang,
  title,
  description,
  canonical = Astro.url.pathname,
  alternates = Object.fromEntries(
    Object.keys(languages).map((l) => [l, getRelativeLocaleUrl(l)]),
  ) as Record<Lang, string>,
  ogType = 'website',
  ogImage = `/og/home-${lang}.png`,
  contentLang = lang,
  published,
  modified,
  tags = [],
} = Astro.props;

const t = useTranslations(lang);
const pageTitle = title ?? t('meta.title');
const pageDescription = description ?? t('meta.description');
const canonicalUrl = new URL(canonical, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const ogLocale = { en: 'en_US', es: 'es_GT' }[contentLang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#282c34" />
    <!-- Lets CSS hide animated elements only when the script that shows them will run -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      Object.entries(alternates).map(([l, path]) => (
        <link rel="alternate" hreflang={l} href={new URL(path, Astro.site)} />
      ))
    }
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — Blog`}
      href={new URL('rss.xml', Astro.site)}
    />

    <!-- Open Graph: how the link looks when shared on LinkedIn and other sites -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Inter:wght@400;500&display=swap"
    />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
