---
import Icon from './Icon.astro';
import SectionTitle from './SectionTitle.astro';
import { site } from '../config';
import { getCredentials, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { earned, training } = getCredentials(lang);
const groups = [
  { id: 'earned', title: t('certs.earned'), credentials: earned },
  { id: 'training', title: t('certs.training'), credentials: training },
];
const filters = [
  { id: 'all', title: t('certs.filter.all') },
  { id: 'earned', title: t('certs.filter.earned') },
  { id: 'training', title: t('certs.training') },
];
---

<section id="certs" class="section">
  <div class="container">
    <div class="cert-head">
      <SectionTitle title={t('certs.heading')} eyebrow="verify --certs" />
      <div class="filters" data-cert-filters role="group" aria-label={t('certs.filter.label')} hidden>
        {filters.map(({ id, title }) => (
          <button type="button" data-cert-filter={id} aria-controls="credential-grid" aria-pressed={id === 'all'}>
            {title}
          </button>
        ))}
      </div>
    </div>
    <div class="grid" id="credential-grid" data-cert-view="all">
      {groups.map(({ id, title, credentials }) => (
        <div class="cert-col" data-cert-group={id}>
          <div class="col-head">
            <h3>{title}</h3>
            <span class="count" aria-hidden="true">{credentials.length}</span>
          </div>
          <ul class="panel list" data-reactive>
            {credentials.map(({ name, issuer, status, label, detail }) => (
              <li class="item">
                <div class="item-top">
                  <h4>{name}</h4>
                  <span class={`status status-${status}`}>{label}</span>
                </div>
                <p class="metadata">
                  <span class="issuer">{issuer}</span>
                  {detail && <span class="detail">{detail}</span>}
                </p>
              </li>
            ))}
          </ul>
          {id === 'earned' && (
            <a class="btn btn-sm credly" href={site.credly} target="_blank" rel="noopener noreferrer">
              <Icon name="award" size={15} />
              {t('certs.credly')}
              <Icon name="arrow-up-right" size={14} />
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const controls = document.querySelector<HTMLElement>('[data-cert-filters]');
  const grid = document.querySelector<HTMLElement>('#credential-grid');

  if (controls && grid) {
    const buttons = controls.querySelectorAll<HTMLButtonElement>('[data-cert-filter]');
    const groups = grid.querySelectorAll<HTMLElement>('[data-cert-group]');
    controls.hidden = false;

    buttons.forEach((button) => button.addEventListener('click', () => {
      const view = button.dataset.certFilter;
      if (!view || grid.dataset.certView === view) return;

      grid.dataset.certView = view;
      buttons.forEach((option) => option.setAttribute('aria-pressed', String(option === button)));
      groups.forEach((group) => {
        group.hidden = view !== 'all' && view !== group.dataset.certGroup;
      });
    }));
  }
</script>

<style>
  .cert-head {
    display: grid;
    gap: 16px;
    margin-bottom: clamp(26px, 4vw, 44px);
  }

  .cert-head :global(.section-heading) { margin-bottom: 0; }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    width: fit-content;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(10 15 25 / 0.85);
  }

  .filters[hidden] { display: none; }

  .filters button {
    min-height: 36px;
    padding: 5px 14px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: 500 0.85rem/1.4 var(--font-sans);
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  .filters button:hover { color: var(--ink-strong); }

  .filters button[aria-pressed='true'] {
    border-color: rgb(167 139 250 / 0.3);
    background: rgb(167 139 250 / 0.14);
    color: var(--ink-strong);
  }

  .grid {
    display: grid;
    gap: 28px;
  }

  @media (min-width: 780px) {
    .grid[data-cert-view='all'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
  }

  @media (min-width: 1050px) {
    .cert-head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
  }

  .grid[data-cert-view]:not([data-cert-view='all']) {
    grid-template-columns: minmax(0, 820px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .grid:not([data-cert-view='all']) [data-cert-group]:not([hidden]) {
      animation: cert-in 0.38s var(--ease-out);
    }
  }

  @keyframes cert-in {
    from { opacity: 0.35; transform: translateY(7px); }
  }

  .col-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  h3 {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 22px;
    padding: 0 7px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-deep);
    color: var(--accent-2);
    font: 0.75rem/1 var(--font-mono);
  }

  .list {
    overflow: clip;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item {
    display: grid;
    gap: 8px;
    padding: 18px 20px;
    transition: background 0.22s ease;
  }

  .item:hover { background: rgb(167 139 250 / 0.045); }

  .item + .item {
    border-top: 1px solid var(--line);
  }

  .item-top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px 14px;
  }

  h4 {
    flex: 1 1 200px;
    margin: 0;
    font-size: 1.04rem;
    line-height: 1.35;
  }

  .metadata {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.85rem;
  }

  .issuer {
    color: var(--ink);
  }

  .detail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .detail::before {
    content: '·';
    color: var(--line-strong);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: none;
    padding: 3px 9px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-raised);
    font: 0.75rem/1.4 var(--font-mono);
    white-space: nowrap;
  }

  .status::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .status-done {
    border-color: rgb(52 211 153 / 0.28);
    background: rgb(52 211 153 / 0.09);
    color: var(--green);
  }

  .status-progress {
    border-color: rgb(251 191 36 / 0.28);
    background: rgb(251 191 36 / 0.09);
    color: var(--yellow);
  }

  .status-accepted {
    border-color: rgb(34 211 238 / 0.28);
    background: rgb(34 211 238 / 0.09);
    color: var(--accent-2);
  }

  .credly {
    margin-top: 16px;
  }
</style>
