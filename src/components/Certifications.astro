---
import SectionTitle from './SectionTitle.astro';
import { site } from '../config';
import { getCredentials, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { earned, training } = getCredentials(lang);
const groups = [
  { id: 'earned', title: t('certs.earned'), credentials: earned },
  { id: 'training', title: t('certs.training'), credentials: training },
];
const filters = [
  { id: 'all', title: t('certs.filter.all') },
  { id: 'earned', title: t('certs.filter.earned') },
  { id: 'training', title: t('certs.training') },
];
---

<section id="certs" class="section">
  <div class="container">
    <div class="cert-head">
      <SectionTitle title={t('certs.heading')} />
      <div class="filters" data-cert-filters role="group" aria-label={t('certs.filter.label')} hidden>
        {filters.map(({ id, title }) => (
          <button type="button" data-cert-filter={id} aria-controls="credential-grid" aria-pressed={id === 'all'}>
            {title}
          </button>
        ))}
      </div>
    </div>
    <div class="grid" id="credential-grid" data-cert-view="all">
      {groups.map(({ id, title, credentials }) => (
        <div data-cert-group={id}>
          <h3>{title}</h3>
          <ul class="panel list" data-reactive>
            {credentials.map(({ name, issuer, status, label, detail }) => (
              <li class="item">
                <h4>{name}</h4>
                <p class="metadata">
                  <span>{issuer}</span>
                  {detail && <span>{detail}</span>}
                </p>
                <span class={`status status-${status}`}>{label}</span>
              </li>
            ))}
          </ul>
          {id === 'earned' && (
            <a class="btn btn-sm credly" href={site.credly} target="_blank" rel="noopener noreferrer">
              {t('certs.credly')}
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const controls = document.querySelector<HTMLElement>('[data-cert-filters]');
  const grid = document.querySelector<HTMLElement>('#credential-grid');

  if (controls && grid) {
    const buttons = controls.querySelectorAll<HTMLButtonElement>('[data-cert-filter]');
    const groups = grid.querySelectorAll<HTMLElement>('[data-cert-group]');
    controls.hidden = false;

    buttons.forEach((button) => button.addEventListener('click', () => {
      const view = button.dataset.certFilter;
      if (!view || grid.dataset.certView === view) return;

      grid.dataset.certView = view;
      buttons.forEach((option) => option.setAttribute('aria-pressed', String(option === button)));
      groups.forEach((group) => {
        group.hidden = view !== 'all' && view !== group.dataset.certGroup;
      });
    }));
  }
</script>

<style>
  .cert-head {
    display: grid;
    gap: 16px;
    margin-bottom: clamp(25px, 4vw, 44px);
  }

  .cert-head :global(.section-heading) { margin-bottom: 0; }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    width: fit-content;
    padding: 5px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--surface-deep);
  }

  .filters[hidden] { display: none; }

  .filters button {
    min-height: 36px;
    padding: 5px 12px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: 0.875rem/1.4 var(--font-sans);
    cursor: pointer;
  }

  .filters button:hover { color: var(--accent); }

  .filters button[aria-pressed='true'] {
    border-color: rgb(192 175 252 / 0.24);
    background: rgb(192 175 252 / 0.13);
    color: var(--ink-strong);
  }

  .grid {
    display: grid;
    gap: 28px;
  }

  @media (min-width: 760px) {
    .grid[data-cert-view='all'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }

  @media (min-width: 1050px) {
    .cert-head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
  }

  .grid[data-cert-view]:not([data-cert-view='all']) {
    grid-template-columns: minmax(0, 750px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .grid:not([data-cert-view='all']) [data-cert-group]:not([hidden]) {
      animation: cert-in 0.38s var(--ease-out);
    }
  }

  @keyframes cert-in {
    from { opacity: 0.35; transform: translateY(7px); }
  }

  h3 {
    margin-bottom: 14px;
    font-size: 1.25rem;
  }

  .list {
    overflow: clip;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item {
    padding: 18px 20px;
    transition: background 0.22s ease;
  }

  .item:hover { background: rgb(192 175 252 / 0.04); }

  .item + .item {
    border-top: 1px solid var(--line);
  }

  h4 {
    margin: 0 0 5px;
    font-size: 1.08rem;
  }

  .metadata {
    display: grid;
    margin: 0 0 8px;
    color: var(--ink);
    font-size: 0.875rem;
  }

  .status {
    display: inline-block;
    padding: 2px 7px;
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    font: 0.8125rem/1.5 var(--font-mono);
  }

  .status-done {
    color: var(--green);
  }

  .status-progress {
    color: var(--yellow);
  }

  .status-accepted {
    color: var(--accent-2);
  }

  .credly {
    margin-top: 14px;
  }
</style>
