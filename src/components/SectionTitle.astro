---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<h2 class="section-heading" data-reveal>{title}</h2>

<style>
  .section-heading {
    display: flex;
    align-items: center;
    gap: clamp(10px, 2vw, 26px);
    margin: 0 0 clamp(24px, 4vw, 44px);
  }

  .section-heading::before {
    flex: 0 0 clamp(12px, 2vw, 23px);
    height: 2px;
    border-radius: 999px;
    content: '';
    background: var(--grad);
    box-shadow: 0 0 11px rgb(192 175 252 / 0.31);
  }
</style>
