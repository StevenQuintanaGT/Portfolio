---
interface Props {
  title: string;
  eyebrow?: string;
}

const { title, eyebrow } = Astro.props;
---

<div class="section-heading" data-reveal>
  {eyebrow && (
    <p class="eyebrow" aria-hidden="true">
      <span class="prompt">$</span> {eyebrow}
    </p>
  )}
  <h2>{title}</h2>
</div>

<style>
  .section-heading {
    margin: 0 0 clamp(24px, 4vw, 44px);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 10px;
    padding: 3px 10px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgb(11 17 32 / 0.8);
    color: var(--accent-2);
    font: 0.75rem/1.4 var(--font-mono);
    letter-spacing: 0.02em;
  }

  h2 {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 22px);
    margin: 0;
  }

  h2::before {
    flex: 0 0 clamp(14px, 2vw, 24px);
    height: 3px;
    border-radius: 999px;
    content: '';
    background: var(--grad);
    box-shadow: 0 0 14px rgb(34 211 238 / 0.36);
  }
</style>
