---
import Icon from './Icon.astro';
import { site } from '../config';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contact" class="section">
  <div class="container">
    <div class="panel cta" data-reveal data-reactive>
      <div class="copy-col">
        <p class="eyebrow" aria-hidden="true"><span class="prompt">$</span> ping steven</p>
        <h2>{t('contact.heading')}</h2>
        <p>{t('contact.text')}</p>
      </div>
      <div class="channels">
        <a class="email" href={`mailto:${site.email}`}>
          <span>{site.email}</span>
          <Icon name="arrow-up-right" size={20} class="email-arrow" />
        </a>
        <div class="actions">
          <button type="button" class="btn btn-sm copy" hidden data-copy-email={site.email}
            data-ready={t('contact.copy')}
            data-copied={t('contact.copied')}
            data-failed={t('contact.copyFailed')}>
            <Icon name="copy" size={14} class="icon-copy" />
            <Icon name="check" size={14} class="icon-check" />
            <span data-copy-label aria-live="polite">{t('contact.copy')}</span>
          </button>
          <a class="btn btn-sm" href={site.github} target="_blank" rel="noopener noreferrer">
            <Icon name="github" size={15} />
            GitHub
          </a>
          <a class="btn btn-sm" href={site.linkedin} target="_blank" rel="noopener noreferrer">
            <Icon name="linkedin" size={15} />
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const label = copyButton?.querySelector<HTMLElement>('[data-copy-label]');

  if (copyButton && label && navigator.clipboard?.writeText) {
    const { copyEmail, ready, copied, failed } = copyButton.dataset;
    let resetTimer = 0;
    copyButton.hidden = false;

    copyButton.addEventListener('click', async () => {
      if (!copyEmail) return;

      try {
        await navigator.clipboard.writeText(copyEmail);
        label.textContent = copied ?? '';
        copyButton.dataset.copyState = 'copied';
      } catch {
        label.textContent = failed ?? '';
        copyButton.dataset.copyState = 'failed';
      }

      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        delete copyButton.dataset.copyState;
        label.textContent = ready ?? '';
      }, 2800);
    });
  }
</script>

<style>
  .cta {
    display: grid;
    align-items: center;
    gap: 28px;
    padding: clamp(26px, 5vw, 56px);
    border-radius: var(--radius-xl);
    border-color: rgb(167 139 250 / 0.24);
    border-block-start-color: rgb(167 139 250 / 0.45);
    background:
      radial-gradient(ellipse 60% 80% at 92% 0%, rgb(135 108 232 / 0.22), transparent 68%),
      radial-gradient(ellipse 45% 65% at 10% 100%, rgb(34 211 238 / 0.1), transparent 72%),
      var(--panel-fill);
  }

  @media (min-width: 780px) {
    .cta {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
      gap: 40px;
    }

    .channels {
      justify-self: end;
    }
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 12px;
    padding: 3px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(10 15 25 / 0.72);
    color: var(--accent-2);
    font: 0.75rem/1.4 var(--font-mono);
  }

  h2 {
    margin: 0 0 12px;
  }

  .copy-col p:last-child {
    margin: 0;
    max-width: 44ch;
    font-size: 1.05rem;
  }

  .email {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    color: var(--ink-strong);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 1.95rem);
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color 0.2s ease;
  }

  .email :global(.email-arrow) {
    color: var(--accent);
    transition: transform 0.22s var(--ease-out);
  }

  .email:hover {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .email:hover :global(.email-arrow) {
      transform: translate(3px, -3px);
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .copy[hidden] { display: none; }

  .copy {
    min-width: 128px;
    border-color: rgb(167 139 250 / 0.34);
    background: rgb(167 139 250 / 0.12);
    color: var(--accent);
    cursor: pointer;
  }

  .copy :global(.icon-check) { display: none; }

  .copy[data-copy-state='copied'] {
    border-color: rgb(52 211 153 / 0.42);
    background: rgb(52 211 153 / 0.12);
    color: #b7f5ca;
  }

  .copy[data-copy-state='copied'] :global(.icon-copy) { display: none; }
  .copy[data-copy-state='copied'] :global(.icon-check) { display: inline-block; }

  .copy[data-copy-state='failed'] {
    border-color: rgb(251 113 133 / 0.4);
    color: var(--red);
  }
</style>
