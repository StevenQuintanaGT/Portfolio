---
import Icon from './Icon.astro';
import { site } from '../config';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <div class="identity">
      <img class="mark" src="/brand/symbol.svg" alt="" width="22" height="22" />
      <img class="signature" src="/brand/signature.svg" alt="msquintana" width="480" height="110" />
      <span class="copy">© {year} {site.name}</span>
    </div>
    <p class="stack">{t('footer.built')}</p>
    <a href="#" class="top">
      <span>{t('footer.top')}</span>
      <Icon name="arrow-up" size={14} />
    </a>
  </div>
</footer>

<style>
  .footer {
    padding: 28px 0;
    border-top: 1px solid var(--line-strong);
    background: rgb(7 11 20 / 0.78);
    color: var(--ink-muted);
    font-size: 0.875rem;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 24px;
  }

  p {
    margin: 0;
    max-width: none;
  }

  .identity {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
    color: var(--ink);
  }

  .mark {
    display: block;
    flex: none;
  }

  .signature {
    display: block;
    width: auto;
    height: 22px;
  }

  .copy {
    padding-inline-start: 12px;
    border-inline-start: 1px solid var(--line-strong);
    color: var(--ink-muted);
    font-size: 0.8125rem;
  }

  .stack {
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .top {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgb(15 23 42 / 0.75);
    color: var(--ink);
    font-size: 0.8125rem;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .top:hover {
    border-color: rgb(34 211 238 / 0.55);
    background: var(--surface-raised);
    color: var(--ink-strong);
  }
</style>
