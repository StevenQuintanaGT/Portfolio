---
import SectionTitle from './SectionTitle.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const education = [
  { title: t('education.degree'), school: t('education.degree.school'), period: t('education.degree.period') },
  { title: t('education.accounting'), school: 'Instituto Privado de Educación Diversificada El Porvenir', period: '2019–2021' },
  { title: t('education.technician'), school: 'Academia de Computación ACCESA', period: '2016–2017' },
];
---

<section id="about" class="section">
  <div class="container">
    <SectionTitle index="01" text={t('about.title')} title={t('about.heading')} />
    <div class="bento">
      <div class="card hover-lift story">
        <p class="file" aria-hidden="true"><span class="prompt">$</span> cat about.md</p>
        <p>{t('about.p1')}</p>
        <p>{t('about.p2')}</p>
        <p class="languages">{t('about.languages')}</p>
      </div>
      <div class="card hover-lift">
        <h3>{t('education.heading')}</h3>
        <ul class="education">
          {education.map(({ title, school, period }) => (
            <li>
              <strong>{title}</strong>
              <span>{school}</span>
              <span>{period}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .bento {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 760px) {
    .bento {
      grid-template-columns: 1fr 1fr;
    }
  }

  .card {
    padding: 28px;
    border: 1px solid var(--card-border, var(--line));
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .story {
    display: flex;
    flex-direction: column;
    font-size: 1.08rem;
  }

  .file {
    margin-bottom: 24px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .languages {
    margin: auto 0 0;
    padding-top: 12px;
    color: var(--ink-strong);
    font-size: 0.9rem;
  }

  .education {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .education li {
    display: grid;
    gap: 2px;
    font-size: 0.9rem;
  }

  .education li + li {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }

  .education strong {
    color: var(--ink-strong);
    font-size: 1rem;
  }
</style>
