---
import SectionTitle from './SectionTitle.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const education = [
  { title: t('education.degree'), school: t('education.degree.school'), period: t('education.degree.period') },
  { title: t('education.accounting'), school: 'Instituto Privado de Educación Diversificada El Porvenir', period: '2019–2021' },
  { title: t('education.technician'), school: 'Academia de Computación ACCESA', period: '2016–2017' },
];
---

<section id="about" class="section">
  <div class="container profile">
    <div class="story">
      <SectionTitle title={t('about.heading')} />
      <p>{t('about.p1')}</p>
      <p>{t('about.p2')}</p>
      <p class="languages">{t('about.languages')}</p>
    </div>
    <div class="panel education-panel" data-reactive>
      <h3>{t('education.heading')}</h3>
      <ul class="education">
        {education.map(({ title, school, period }) => (
          <li data-reveal>
            <strong>{title}</strong>
            <span>{school}</span>
            <span>{period}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .profile {
    display: grid;
    align-items: start;
    gap: clamp(24px, 5.5vw, 80px);
  }

  @media (min-width: 760px) {
    .profile {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.93fr);
    }
  }

  .story {
    font-size: clamp(1.025rem, 1.6vw, 1.14rem);
  }

  .languages {
    margin: 24px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    color: var(--ink-strong);
    font-size: 0.875rem;
  }

  .education-panel {
    padding: clamp(18px, 3vw, 30px);
    border-top-color: rgb(192 175 252 / 0.31);
  }

  h3 {
    margin-bottom: 20px;
    font-size: 1.35rem;
  }

  .education {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .education li {
    display: grid;
    gap: 4px;
    font-size: 0.9375rem;
  }

  .education li + li {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }

  .education li:nth-child(2) { --reveal-delay: 75ms; }
  .education li:nth-child(3) { --reveal-delay: 145ms; }

  .education strong {
    color: var(--ink-strong);
    font-size: 1rem;
  }

  .education span:last-child {
    color: var(--ink-muted);
    font: 0.8125rem/1.6 var(--font-mono);
  }
</style>
