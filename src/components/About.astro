---
import Icon from './Icon.astro';
import SectionTitle from './SectionTitle.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const education = [
  { title: t('education.degree'), school: t('education.degree.school'), period: t('education.degree.period'), current: true },
  { title: t('education.accounting'), school: 'Instituto Privado de Educación Diversificada El Porvenir', period: '2019–2021', current: false },
  { title: t('education.technician'), school: 'Academia de Computación ACCESA', period: '2016–2017', current: false },
];
---

<section id="about" class="section">
  <div class="container profile">
    <div class="story">
      <SectionTitle title={t('about.heading')} eyebrow="cat ~/about.md" />
      <p>{t('about.p1')}</p>
      <p>{t('about.p2')}</p>
      <div class="facts">
        <span class="fact">
          <Icon name="map-pin" size={14} />
          Guatemala
        </span>
        <span class="fact">
          <Icon name="globe" size={14} />
          {t('about.languages')}
        </span>
      </div>
    </div>
    <div class="panel education-panel" data-reactive>
      <div class="panel-head">
        <span class="panel-icon" aria-hidden="true">
          <Icon name="graduation" size={18} />
        </span>
        <h3>{t('education.heading')}</h3>
      </div>
      <ul class="education">
        {education.map(({ title, school, period, current }) => (
          <li class:list={{ current }} data-reveal>
            <span class="edu-node" aria-hidden="true"></span>
            <span class="edu-period">{period}</span>
            <strong>{title}</strong>
            <span class="edu-school">{school}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .profile {
    display: grid;
    align-items: start;
    gap: clamp(28px, 5vw, 72px);
  }

  @media (min-width: 820px) {
    .profile {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }
  }

  .story {
    font-size: clamp(1.025rem, 1.55vw, 1.125rem);
  }

  .story p {
    line-height: 1.72;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .fact {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(10 15 25 / 0.78);
    color: var(--ink-strong);
    font-size: 0.85rem;
  }

  .fact :global(.icon-svg) {
    color: var(--accent-2);
  }

  .education-panel {
    padding: clamp(22px, 3vw, 32px);
    border-top-color: rgb(167 139 250 / 0.34);
    background:
      radial-gradient(ellipse 70% 50% at 100% 0%, rgb(167 139 250 / 0.08), transparent 68%),
      var(--panel-fill);
  }

  .panel-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }

  .panel-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgb(167 139 250 / 0.28);
    border-radius: var(--radius-md);
    background: rgb(167 139 250 / 0.1);
    color: var(--accent);
  }

  h3 {
    margin: 0;
    font-size: 1.28rem;
  }

  .education {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .education li {
    position: relative;
    display: grid;
    gap: 4px;
    padding-inline-start: 22px;
    font-size: 0.9375rem;
  }

  .education li:not(:last-child)::before {
    position: absolute;
    inset: 14px auto -20px 4px;
    width: 1px;
    content: '';
    background: var(--line);
  }

  .education li + li {
    margin-top: 20px;
  }

  .edu-node {
    position: absolute;
    top: 7px;
    left: 0;
    width: 9px;
    height: 9px;
    border: 1.5px solid var(--line-strong);
    border-radius: 50%;
    background: var(--surface-deep);
  }

  .education li.current .edu-node {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 4px rgb(167 139 250 / 0.16);
  }

  .education li:nth-child(2) { --reveal-delay: 75ms; }
  .education li:nth-child(3) { --reveal-delay: 145ms; }

  .edu-period {
    width: fit-content;
    margin-bottom: 2px;
    color: var(--ink-muted);
    font: 0.78rem/1.4 var(--font-mono);
  }

  .education li.current .edu-period {
    color: var(--accent-2);
  }

  .education strong {
    color: var(--ink-strong);
    font-size: 1rem;
    line-height: 1.35;
  }

  .edu-school {
    color: var(--ink);
    font-size: 0.9rem;
  }
</style>
