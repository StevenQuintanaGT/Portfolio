---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { site } from '../config';
import { getProjects } from '../lib/projects';
import { certs, skills, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Commands shown by `help` and as quick buttons under the prompt
const commands = ['help', 'whoami', 'about', 'skills', 'projects', 'certs', 'contact', 'lang', 'clear'] as const;
const quickCommands = ['help', 'projects', 'skills', 'contact'];

// Everything the terminal can print, read by scripts/terminal.ts
const terminalData = {
  otherLangUrl: getRelativeLocaleUrl(lang === 'en' ? 'es' : 'en'),
  name: site.name,
  role: t('hero.role'),
  about: [t('about.p1'), t('about.p2'), t('about.p3')],
  skills: [
    { title: t('skills.security'), items: skills.security },
    { title: t('skills.systems'), items: skills.systems },
    { title: t('skills.cloud'), items: skills.cloud },
  ],
  projects: (await getProjects(lang)).map(({ data }) => ({
    title: data.title,
    tools: data.tools,
    demo: data.demo,
    repo: data.repo,
  })),
  certs: certs.map((cert) => ({ ...cert, label: t(`certs.status.${cert.status}`) })),
  contact: { email: site.email, github: site.github, linkedin: site.linkedin },
  help: commands.map((name) => ({ name, text: t(`term.help.${name}`) })),
  text: {
    helpTitle: t('term.help.title'),
    notFound: t('term.notFound'),
    sudo: t('term.sudo'),
    switching: t('term.switching'),
    demo: t('projects.demo'),
    repo: t('projects.repo'),
  },
};

// Safe to embed inside <script>: no "</script>" can sneak in
const terminalJson = JSON.stringify(terminalData).replace(/</g, '\\u003c');

// Scrolling strip of every tool, under the hero
const allSkills = [...skills.security, ...skills.systems, ...skills.cloud];
---

<section class="hero" data-hero>
  <div class="container hero-grid">
    <div class="intro">
      <p class="badge rise" style="--i: 0">
        <span class="pulse" aria-hidden="true"></span>{t('hero.status')}
      </p>
      <h1 class="rise" style="--i: 1">
        <span class="hello">{t('hero.hello')}</span>
        <span class="name grad-text">{site.name}</span>
      </h1>
      <p class="role rise" style="--i: 2">{t('hero.role')}</p>
      <p class="tagline rise" style="--i: 3">{t('hero.tagline')}</p>
      <div class="actions rise" style="--i: 4">
        <a class="btn btn-primary" href="#projects">{t('hero.cta.projects')} <span aria-hidden="true">→</span></a>
        <a class="btn" href="#contact">{t('hero.cta.contact')}</a>
      </div>
      <ul class="socials rise" style="--i: 5">
        <li><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></li>
        <li><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>

    <div class="terminal rise" style="--i: 3">
      <div class="bar" aria-hidden="true">
        <span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span>
        <span class="bar-title">steven@msquintana: ~</span>
      </div>
      <div class="body">
        <!-- The script types `whoami`, then shows each output block in order -->
        <p class="cmd">
          <span class="prompt">$</span> <span data-hero-cmd>whoami</span><span
            class="cursor"
            data-hero-cursor
            aria-hidden="true"></span>
        </p>
        <dl class="whoami line" data-hero-line>
          <div><dt>name</dt><dd>{site.name}</dd></div>
          <div><dt>role</dt><dd>{t('hero.role')}</dd></div>
          <div><dt>base</dt><dd>Guatemala</dd></div>
          <div><dt>status</dt><dd class="ok">[+] {t('hero.status')}</dd></div>
        </dl>

        <!-- Interactive terminal: needs JS, so it stays hidden without it -->
        <div class="term line" data-hero-line data-term hidden>
          <div class="term-log" data-term-log aria-live="polite"></div>
          <form class="term-form" data-term-form>
            <label class="prompt" for="term-input">$</label>
            <input
              id="term-input"
              class="term-input"
              data-term-input
              type="text"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              aria-label={t('term.label')}
              placeholder={t('term.placeholder')}
            />
          </form>
          <div class="term-quick">
            <span class="term-hint">{t('term.hint')}</span>
            {
              quickCommands.map((cmd) => (
                <button type="button" class="term-chip" data-term-run={cmd}>
                  {cmd}
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="marquee" aria-hidden="true">
    <div class="track">
      {
        [0, 1].map(() => (
          <ul>
            {allSkills.map((skill) => (
              <li>{skill}</li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <script type="application/json" id="terminal-data" set:html={terminalJson} />
</section>

<script>
  import '../scripts/terminal';
</script>

<style>
  .hero {
    padding: 72px 0 0;
  }

  .hero-grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.05fr 1fr;
      gap: 56px;
    }
  }

  /* --- Intro --- */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
    padding: 6px 14px 6px 10px;
    border: 1px solid rgba(74, 222, 128, 0.3);
    border-radius: 999px;
    background: rgba(74, 222, 128, 0.08);
    color: var(--green);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pulse::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--green);
      animation: ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
  }

  @keyframes ping {
    75%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  h1 {
    margin-bottom: 16px;
  }

  .hello {
    display: block;
    margin-bottom: 4px;
    color: var(--ink);
    font-size: clamp(1.1rem, 2.4vw, 1.4rem);
    font-weight: 500;
    letter-spacing: 0;
  }

  .name {
    display: block;
    font-size: clamp(2.8rem, 7.5vw, 4.75rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }

  .role {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--accent-2);
    margin-bottom: 16px;
  }

  .tagline {
    font-size: 1.15rem;
    color: var(--ink);
    margin-bottom: 32px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 28px;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .socials a {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .socials a:hover {
    color: var(--ink-strong);
  }

  /* --- Terminal window --- */
  .terminal {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-xl);
    background: rgba(14, 16, 23, 0.85);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow:
      0 0 0 1px rgba(167, 139, 250, 0.08),
      0 40px 100px -30px rgba(167, 139, 250, 0.35);
    overflow: hidden;
    min-width: 0;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.02);
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    opacity: 0.85;
  }

  .red {
    background: var(--red);
  }

  .yellow {
    background: var(--yellow);
  }

  .green {
    background: var(--green);
  }

  .bar-title {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink);
  }

  .body {
    padding: 24px;
    font-family: var(--font-mono);
    font-size: 0.88rem;
  }

  .cmd {
    color: var(--ink-strong);
    margin-bottom: 16px;
  }

  .whoami {
    display: grid;
    gap: 6px;
    margin: 0;
  }

  .whoami div {
    display: flex;
    gap: 12px;
  }

  .whoami dt {
    min-width: 7ch;
    color: var(--accent-2);
  }

  .whoami dd {
    margin: 0;
    color: var(--ink-strong);
  }

  .whoami .ok {
    color: var(--green);
  }

  /* Hidden until the typing intro reveals them (only when JS runs) */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .line {
      opacity: 0;
      transform: translateY(8px);
      transition:
        opacity 0.5s ease,
        transform 0.5s ease;
    }

    :global(.js) .line.is-visible {
      opacity: 1;
      transform: none;
    }

    /* Avoid a flash of the full command before typing starts */
    :global(.js) [data-hero-cmd]:not([data-typing]) {
      visibility: hidden;
    }
  }

  /* --- Interactive terminal --- */
  .term {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px dashed var(--line-strong);
  }

  .term[hidden] {
    display: none;
  }

  .term-log {
    max-height: 240px;
    overflow-y: auto;
  }

  .term-log:empty {
    display: none;
  }

  .term-log :global(.out) {
    margin: 0 0 4px;
    max-width: none;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .term-log :global(.out-cmd) {
    color: var(--ink-strong);
    margin-top: 12px;
  }

  .term-log :global(.out-cmd:first-child) {
    margin-top: 0;
  }

  .term-log :global(.out-title) {
    color: var(--ink-strong);
  }

  .term-log :global(.out-key) {
    display: inline-block;
    min-width: 10ch;
    color: var(--accent-2);
  }

  .term-log :global(.out-tag) {
    color: var(--purple);
  }

  .term-log :global(.out-error) {
    color: var(--red);
  }

  .term-form {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 0.2s ease;
  }

  .term-form:focus-within {
    border-color: rgba(167, 139, 250, 0.5);
  }

  .term-input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--ink-strong);
    font: inherit;
    caret-color: var(--green);
    outline: none;
  }

  .term-input::placeholder {
    color: var(--ink);
    opacity: 0.75;
  }

  .term-quick {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
  }

  .term-hint {
    color: var(--ink);
    font-size: 0.78rem;
  }

  .term-chip {
    padding: 4px 12px;
    border: 1px solid rgba(167, 139, 250, 0.25);
    border-radius: 999px;
    background: rgba(167, 139, 250, 0.08);
    color: var(--purple);
    font: inherit;
    font-size: 0.78rem;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .term-chip:hover {
    border-color: var(--accent);
  }

  @media (max-width: 480px) {
    .body {
      padding: 20px 16px;
    }

    .bar-title {
      display: none;
    }
  }

  /* --- Tool strip --- */
  .marquee {
    margin-top: 88px;
    padding: 18px 0;
    border-block: 1px solid var(--line);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .track {
    display: flex;
    width: max-content;
  }

  .track ul {
    display: flex;
    gap: 40px;
    margin: 0;
    padding: 0 40px 0 0;
    list-style: none;
  }

  .track li {
    display: flex;
    align-items: center;
    gap: 40px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ink);
    white-space: nowrap;
  }

  .track li::before {
    content: '◆';
    font-size: 0.55rem;
    color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .track {
      animation: scroll 40s linear infinite;
    }

    .marquee:hover .track {
      animation-play-state: paused;
    }
  }

  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }
</style>
