---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Icon from './Icon.astro';
import { site } from '../config';
import { blogUrl, getPosts, postUrl } from '../lib/blog';
import { getProjects } from '../lib/projects';
import { getCredentials, getExperience, skills, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Commands shown by `help` and as quick buttons under the prompt
const commands = ['help', 'whoami', 'about', 'experience', 'skills', 'projects', 'certs', 'blog', 'contact', 'lang', 'clear'] as const;
const quickCommands = ['help', 'projects', 'blog', 'certs'];
const { earned, training } = getCredentials(lang);
const [projects, posts] = await Promise.all([getProjects(lang), getPosts()]);

// Everything the terminal can print, read by scripts/terminal.ts
const terminalData = {
  otherLangUrl: getRelativeLocaleUrl(lang === 'en' ? 'es' : 'en'),
  blogUrl: blogUrl(lang),
  name: site.name,
  role: t('hero.role'),
  about: [t('about.p1'), t('about.p2'), t('about.languages')],
  experience: getExperience(lang),
  skills: [
    { title: t('skills.security'), items: [...skills.security, t('skills.ipv4')] },
    { title: t('skills.systems'), items: skills.systems },
    { title: t('skills.cloud'), items: skills.cloud },
  ],
  projects: projects.map(({ data }) => ({
    title: data.title,
    tools: data.tools,
    demo: data.demo,
    article: data.article ? blogUrl(lang, `${data.article}/`) : undefined,
    repo: data.repo,
  })),
  posts: posts.slice(0, 5).map((post) => ({
    title: post.data.title,
    url: postUrl(lang, post),
    tags: post.data.tags,
  })),
  certs: [...earned, ...training],
  credly: site.credly,
  contact: { email: site.email, github: site.github, linkedin: site.linkedin },
  help: commands.map((name) => ({ name, text: t(`term.help.${name}`) })),
  text: {
    helpTitle: t('term.help.title'),
    notFound: t('term.notFound'),
    sudo: t('term.sudo'),
    switching: t('term.switching'),
    demo: t('projects.demo'),
    article: t('projects.article'),
    repo: t('projects.repo'),
    employer: t('experience.employer'),
    credly: t('certs.credly'),
    allPosts: t('latest.all'),
    sections: {
      about: t('nav.about'),
      experience: t('nav.experience'),
      skills: t('nav.skills'),
      projects: t('nav.projects'),
      certs: t('nav.certs'),
      contact: t('nav.contact'),
    },
  },
};

// Safe to embed inside <script>: no "</script>" can sneak in
const terminalJson = JSON.stringify(terminalData).replace(/</g, '\\u003c');

const [givenName, ...familyName] = site.name.split(' ');
const toolkit = ['Linux', ...skills.security, 'Docker', 'GitHub', 'Cloudflare', 'AWS'];
---

<section class="hero">
  <div class="hero-art" aria-hidden="true">
    <div class="horizon"></div>
    <canvas class="circuit-field" data-hero-field></canvas>
  </div>
  <div class="container hero-grid">
    <div class="intro">
      <p class="availability rise" style="--i: 0">{t('hero.status')}</p>
      <h1 class="rise" style="--i: 1">
        {givenName} <span>{familyName.join(' ')}</span>
      </h1>
      <p class="role rise" style="--i: 2"><span class="role-prefix" aria-hidden="true">//</span> {t('hero.role')}</p>
      <p class="tagline rise" style="--i: 3">{t('hero.tagline')}</p>
      <div class="actions rise" style="--i: 4">
        <a class="btn btn-primary" href="#projects">
          {t('hero.cta.projects')}
          <Icon name="arrow-right" size={16} />
        </a>
        <a class="btn" href="#contact">
          <Icon name="mail" size={16} />
          {t('hero.cta.contact')}
        </a>
      </div>
      <ul class="socials rise" style="--i: 5">
        <li>
          <a href={site.github} target="_blank" rel="noopener noreferrer">
            <Icon name="github" size={15} />
            <span>GitHub</span>
          </a>
        </li>
        <li>
          <a href={site.linkedin} target="_blank" rel="noopener noreferrer">
            <Icon name="linkedin" size={15} />
            <span>LinkedIn</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${site.email}`}>
            <Icon name="mail" size={15} />
            <span>{site.email}</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="terminal panel rise" style="--i: 2" data-reactive>
      <div class="bar">
        <span class="window-lights" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="window-title" aria-hidden="true">steven@msquintana: ~</span>
      </div>
      <div class="body">
        <div class="signal" data-terminal-signal aria-hidden="true">
          <img src="/brand/symbol.svg" alt="" width="96" height="96" />
          <span></span><span></span><span></span>
        </div>
        <p class="cmd">
          <span class="prompt">$</span> <span data-hero-cmd>whoami</span><span
            class="cursor"
            data-hero-cursor
            aria-hidden="true"></span>
        </p>
        <dl class="whoami">
          <div><dt>name</dt><dd>{site.name}</dd></div>
          <div><dt>role</dt><dd>{t('hero.role')}</dd></div>
          <div><dt>base</dt><dd>Guatemala</dd></div>
        </dl>

        <!-- Interactive terminal: needs JS, so it stays hidden without it -->
        <div class="term" data-term hidden>
          <div class="term-log" id="term-log" data-term-log role="log"></div>
          <form class="term-form" data-term-form>
            <label class="prompt" for="term-input">$</label>
            <input
              id="term-input"
              class="term-input"
              data-term-input
              type="text"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              aria-label={t('term.label')}
              placeholder={t('term.placeholder')}
            />
          </form>
          <div class="term-quick">
            {
              quickCommands.map((cmd) => (
                <button type="button" class="term-chip" data-term-run={cmd} aria-controls="term-log">
                  {cmd}
                </button>
              ))
            }
            <button type="button" class="term-chip term-clear" data-term-run="clear" aria-controls="term-log" hidden>
              {t('term.clear')}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="tech-strip">
      <div class="tech-track">
        {[false, true].map((copy) => (
          <ul class:list={['tech-set', { 'tech-copy': copy }]} aria-hidden={copy ? 'true' : undefined}>
            {toolkit.map((tool) => <li>{tool}</li>)}
          </ul>
        ))}
      </div>
    </div>
  </div>

  <script type="application/json" id="terminal-data" set:html={terminalJson} />
</section>

<script>
  import '../scripts/terminal';
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: clamp(52px, 6.4vw, 96px) 0;
  }

  .hero-art {
    position: absolute;
    z-index: -1;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(ellipse 52% 71% at 79% 48%, rgb(124 58 237 / 0.22), transparent 83%),
      radial-gradient(ellipse 60% 43% at 100% 70%, rgb(2 132 199 / 0.16), transparent 90%);
    mask-image: linear-gradient(#000 78%, transparent);
  }

  .horizon {
    position: absolute;
    inset: 40% -30% -48%;
    transform: perspective(540px) rotateX(55deg);
    transform-origin: top center;
    background:
      linear-gradient(rgb(148 163 184 / 0.16) 1px, transparent 1px),
      linear-gradient(90deg, rgb(148 163 184 / 0.16) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 43% 56% at 59% 31%, #000 15%, transparent 90%);
  }

  .circuit-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    mask-image: linear-gradient(90deg, transparent 22%, #000 58%);
  }

  .hero-grid {
    display: grid;
    align-items: center;
    gap: clamp(32px, 5.6vw, 78px);
  }

  @media (min-width: 840px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.04fr) minmax(0, 1fr);
    }
  }

  h1 {
    width: fit-content;
    margin: 0 0 18px;
    color: var(--ink-strong);
    font-size: clamp(3.4rem, 7.6vw, 6.4rem);
    font-weight: 700;
    line-height: 0.96;
    letter-spacing: -0.055em;
  }

  h1 span {
    display: block;
    padding-bottom: 0.06em;
    background: linear-gradient(102deg, #C4B5FD 0%, #A78BFA 42%, #22D3EE 100%);
    background-clip: text;
    color: transparent;
  }

  .role {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    color: var(--accent-2);
    font: 0.875rem/1.5 var(--font-mono);
    letter-spacing: 0.01em;
  }

  .role-prefix {
    color: var(--ink-muted);
  }

  .tagline {
    max-width: 41ch;
    margin-bottom: 26px;
    color: var(--ink);
    font-size: clamp(1.025rem, 1.55vw, 1.175rem);
    line-height: 1.65;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 20px;
    padding: 5px 13px;
    border: 1px solid rgb(52 211 153 / 0.3);
    border-radius: 999px;
    background: rgb(6 78 59 / 0.24);
    box-shadow: inset 0 1px 0 rgb(110 231 183 / 0.12);
    color: #a7f3d0;
    font: 0.8125rem/1.45 var(--font-mono);
  }

  .availability::before {
    content: '';
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 10px rgb(52 211 153 / 0.65);
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .socials a:hover {
    color: var(--ink-strong);
  }

  .socials a:hover :global(.icon-svg) {
    color: var(--accent);
  }

  .terminal {
    overflow: hidden;
    border-color: rgb(167 139 250 / 0.28);
    border-radius: var(--radius-xl);
    background: linear-gradient(150deg, #131d35 0%, #090f1d 68%);
    box-shadow:
      0 0 0 6px rgb(167 139 250 / 0.04),
      0 26px 75px rgb(0 0 0 / 0.58),
      0 0 55px rgb(124 58 237 / 0.14),
      inset 0 1px rgb(196 181 253 / 0.12);
  }

  .bar {
    display: grid;
    grid-template-columns: 45px minmax(0, 1fr) 45px;
    align-items: center;
    min-height: 46px;
    gap: 4px;
    padding: 5px 15px;
    border-bottom: 1px solid var(--line-strong);
    background: linear-gradient(90deg, rgb(167 139 250 / 0.1), rgb(34 211 238 / 0.05));
  }

  .window-lights {
    display: flex;
    gap: 6px;
  }

  .window-lights i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #f4819c;
    box-shadow: 0 0 9px color-mix(in srgb, currentColor 25%, transparent);
    color: #f4819c;
  }

  .window-lights i:nth-child(2) { background: #f8c889; color: #f8c889; }
  .window-lights i:nth-child(3) { background: #8ce4ac; color: #8ce4ac; }

  .window-title {
    overflow: hidden;
    color: var(--ink);
    font: clamp(0.6875rem, 1.1vw, 0.8125rem)/1.4 var(--font-mono);
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .body {
    position: relative;
    isolation: isolate;
    padding: clamp(16px, 3vw, 30px);
    font: 0.875rem/1.65 var(--font-mono);
  }

  .signal {
    position: absolute;
    z-index: -1;
    top: 10px;
    right: 12px;
    width: clamp(97px, 17vw, 200px);
    height: 132px;
    pointer-events: none;
  }

  .signal img {
    position: absolute;
    inset: 50% 14% auto auto;
    width: clamp(58px, 9.5vw, 114px);
    height: auto;
    transform: translateY(-50%);
    opacity: 0.13;
  }

  .signal span {
    position: absolute;
    inset: 28% 0 auto;
    height: 1px;
    overflow: hidden;
    color: var(--accent-2);
    background: linear-gradient(90deg, transparent, color-mix(in srgb, currentColor 28%, transparent));
  }

  .signal span:nth-of-type(2) {
    inset-block-start: 50%;
    color: var(--accent);
  }

  .signal span:nth-of-type(3) {
    inset-block-start: 72%;
  }

  .cmd {
    min-height: 1lh;
    margin-bottom: 16px;
    color: var(--ink-strong);
  }

  .whoami {
    display: grid;
    gap: 7px;
    margin: 0;
    padding-inline-start: 14px;
    border-inline-start: 2px solid rgb(167 139 250 / 0.4);
  }

  .whoami div {
    display: grid;
    grid-template-columns: 5.5ch minmax(0, 1fr);
    gap: 12px;
  }

  .whoami dt {
    color: var(--accent-2);
  }

  .whoami dd {
    margin: 0;
    color: var(--ink-strong);
  }

  .term {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .term-log {
    max-height: 216px;
    overflow-y: auto;
    margin-bottom: 12px;
    padding-inline-end: 4px;
    scrollbar-width: thin;
  }

  .term-log:empty {
    display: none;
  }

  .term-log :global(.out) {
    margin: 0 0 4px;
    max-width: none;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .term-log :global(.out-cmd) {
    color: var(--ink-strong);
    margin-top: 12px;
  }

  .term-log :global(.out-link) {
    margin-block: 9px;
  }

  .term-log :global(.out-cmd:first-child) {
    margin-top: 0;
  }

  .term-log :global(.out-title) {
    color: var(--ink-strong);
  }

  .term-log :global(.out-key) {
    display: inline-block;
    min-width: 10ch;
    margin-inline-end: 6px;
    color: var(--accent-2);
  }

  .term-log :global(.out-tag) {
    color: var(--accent);
  }

  .term-log :global(.out-error) {
    color: var(--red);
  }

  .term-form {
    display: flex;
    align-items: center;
    min-height: 44px;
    gap: 10px;
    padding: 8px 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    background: rgb(7 11 20 / 0.88);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .term-form:focus-within {
    border-color: rgb(34 211 238 / 0.65);
    box-shadow: 0 0 0 3px rgb(34 211 238 / 0.14);
  }

  .term-input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--ink-strong);
    font: inherit;
    caret-color: var(--green);
    outline: none;
  }

  .term-input::placeholder {
    color: var(--ink-muted);
  }

  .term-quick {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 12px;
  }

  .term-chip {
    min-height: 32px;
    padding: 4px 11px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgb(167 139 250 / 0.08);
    color: var(--ink);
    font: 0.78rem/1.4 var(--font-mono);
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .term-chip:hover {
    border-color: rgb(34 211 238 / 0.55);
    background: rgb(34 211 238 / 0.12);
    color: var(--ink-strong);
  }

  .term-clear {
    margin-inline-start: auto;
  }

  .tech-strip {
    overflow: hidden;
    margin-top: clamp(38px, 6vw, 74px);
    border-block: 1px solid var(--line);
    background: linear-gradient(90deg, transparent, rgb(113 106 177 / 0.095), transparent);
  }

  .tech-set {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px clamp(18px, 3.5vw, 48px);
    margin: 0;
    padding: 14px 18px;
    list-style: none;
  }

  .tech-set li {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--ink);
    font: 0.8125rem/1.5 var(--font-mono);
    white-space: nowrap;
  }

  .tech-set li::before {
    width: 5px;
    height: 5px;
    content: '';
    border-radius: 1px;
    background: var(--accent);
    transform: rotate(45deg);
    opacity: 0.7;
  }

  .tech-copy {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-art {
      animation: grid-in 1.6s ease-out both;
    }

    .availability::before {
      animation: status-ring 1.6s ease-out 3;
    }

    .signal span::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, transparent 50%, currentColor 72%, transparent 78%);
      animation: signal-pass 2s ease-out 2 both;
    }

    .signal span:nth-of-type(2)::after { animation-delay: 240ms; }
    .signal span:nth-of-type(3)::after { animation-delay: 480ms; }

    .term-log :global(.out-cmd) {
      animation: output-in 220ms ease-out both;
    }

    :global(html[data-motion='playing']) .tech-strip {
      mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    }

    :global(html[data-motion='playing']) .tech-track {
      display: flex;
      width: max-content;
      min-width: 200%;
      animation: tech-loop 31s linear infinite;
    }

    :global(html[data-motion='playing']) .tech-set {
      display: flex;
      flex: 1 0 auto;
      flex-wrap: nowrap;
      justify-content: space-around;
    }

    .tech-strip:hover .tech-track {
      animation-play-state: paused;
    }

    .hero[data-hero-offscreen] .tech-track {
      animation-play-state: paused;
    }
  }

  @keyframes grid-in {
    from { opacity: 0; transform: translateY(10px); }
  }

  @keyframes tech-loop {
    to { transform: translateX(-50%); }
  }

  @keyframes status-ring {
    from { box-shadow: 0 0 0 0 rgb(52 211 153 / 0.56); }
    to { box-shadow: 0 0 0 8px rgb(52 211 153 / 0); }
  }

  @keyframes signal-pass {
    from { transform: translateX(-85%); }
    to { transform: translateX(100%); }
  }

  @keyframes output-in {
    from { opacity: 0.35; transform: translateY(4px); }
  }

  @media (max-width: 520px) {
    .term-input {
      font-size: 1rem;
    }
  }
</style>
