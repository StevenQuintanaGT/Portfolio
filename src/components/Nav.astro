---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  // Where the language button goes (defaults to the home page in the other language)
  switchUrl?: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'en' ? 'es' : 'en';
const switchUrl = Astro.props.switchUrl ?? getRelativeLocaleUrl(otherLang);

// Section links point at the home page so they also work from the blog
const home = getRelativeLocaleUrl(lang);
const blog = getRelativeLocaleUrl(lang, 'blog/');
const onBlog = Astro.url.pathname.startsWith(blog.replace(/\/$/, ''));

const links = [
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#skills`, label: t('nav.skills') },
  { href: `${home}#projects`, label: t('nav.projects') },
  { href: `${home}#certs`, label: t('nav.certs') },
  { href: blog, label: t('nav.blog'), current: onBlog, keepOnPhone: true },
  { href: `${home}#contact`, label: t('nav.contact') },
];
---

<header class="nav">
  <nav class="container nav-inner">
    <a class="brand" href={home}>
      <img src="/logo-steven-quintana.svg" alt="" width="32" height="32" />
      <span><span class="prompt">~/</span>msquintana</span>
    </a>
    <ul class="links">
      {
        links.map((link) => (
          <li class:list={{ keep: link.keepOnPhone }}>
            <a href={link.href} aria-current={link.current ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="lang" href={switchUrl} hreflang={otherLang} lang={otherLang} title={t('nav.switch')}>
      <span class="visually-hidden">{t('nav.switch')}: </span>{otherLang.toUpperCase()}
    </a>
  </nav>
  <div class="progress" data-progress aria-hidden="true"></div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--surface-deep);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 56px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ink-strong);
    font-weight: 700;
    text-decoration: none;
  }

  .links {
    display: flex;
    gap: 16px;
    list-style: none;
    margin: 0 0 0 auto;
    padding: 0;
    font-size: 0.85rem;
  }

  .links a {
    position: relative;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  /* Underline that grows from the left on hover and on the current section */
  .links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    background: var(--blue);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .links a:hover,
  .links a:global(.active),
  .links a[aria-current='page'] {
    color: var(--blue);
  }

  .links a:hover::after,
  .links a:global(.active)::after,
  .links a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 2px;
    background: var(--blue);
    transform: scaleX(0);
    transform-origin: left;
  }

  .lang {
    padding: 4px 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--ink-strong);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .lang:hover {
    border-color: var(--blue);
  }

  /* Spanish labels are longer, so the section links collapse before they can wrap.
     The blog link stays, since it's a separate page. */
  @media (max-width: 960px) {
    .links li:not(.keep) {
      display: none;
    }
  }
</style>
