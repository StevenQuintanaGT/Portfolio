---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  // Where the language button goes (defaults to the home page in the other language)
  switchUrl?: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'en' ? 'es' : 'en';
const switchUrl = Astro.props.switchUrl ?? getRelativeLocaleUrl(otherLang);

// Section links point at the home page so they also work from the blog
const home = getRelativeLocaleUrl(lang);
const blog = getRelativeLocaleUrl(lang, 'blog/');
const onBlog = Astro.url.pathname.startsWith(blog.replace(/\/$/, ''));

const links = [
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#skills`, label: t('nav.skills') },
  { href: `${home}#projects`, label: t('nav.projects') },
  { href: `${home}#certs`, label: t('nav.certs') },
  { href: blog, label: t('nav.blog'), current: onBlog, keepOnPhone: true },
  { href: `${home}#contact`, label: t('nav.contact') },
];
---

<header class="nav">
  <div class="progress" data-progress aria-hidden="true"></div>
  <nav class="nav-inner">
    <a class="brand" href={home}>
      <img src="/logo-steven-quintana.svg" alt="" width="30" height="30" />
      <span>msquintana</span>
    </a>
    <ul class="links">
      {
        links.map((link) => (
          <li class:list={{ keep: link.keepOnPhone }}>
            <a href={link.href} aria-current={link.current ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="lang" href={switchUrl} hreflang={otherLang} lang={otherLang} title={t('nav.switch')}>
      <span class="visually-hidden">{t('nav.switch')}: </span>{otherLang.toUpperCase()}
    </a>
  </nav>
</header>

<style>
  /* Floating glass pill */
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    padding: 16px var(--gutter) 0;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 8px 8px 8px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(14, 16, 23, 0.72);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
    color: var(--ink-strong);
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
  }

  .links {
    display: flex;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .links a {
    display: block;
    padding: 6px 12px;
    border-radius: 999px;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  .links a:hover {
    color: var(--ink-strong);
    background: rgba(255, 255, 255, 0.06);
  }

  /* Current section (set by scripts/motion.ts) or current page */
  .links a:global(.active),
  .links a[aria-current='page'] {
    color: var(--ink-strong);
    background: rgba(167, 139, 250, 0.16);
  }

  .lang {
    padding: 6px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink-strong);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .lang:hover {
    border-color: var(--accent);
  }

  /* Reading progress, pinned to the top edge */
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--grad);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* Spanish labels are longer, so the section links collapse before they can wrap.
     The blog link stays, since it's a separate page. */
  @media (max-width: 960px) {
    .links li:not(.keep) {
      display: none;
    }
  }
</style>
