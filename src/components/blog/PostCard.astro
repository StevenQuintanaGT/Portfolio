---
import PostMeta from './PostMeta.astro';
import TagList from './TagList.astro';
import { postUrl, type Post } from '../../lib/blog';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  post: Post;
}

const { lang, post } = Astro.props;
---

<article class="panel post-card" data-reveal>
  <PostMeta lang={lang} post={post} />
  <h2 lang={post.data.lang}>
    <a href={postUrl(lang, post)}>{post.data.title}</a>
  </h2>
  <p class="description" lang={post.data.lang}>{post.data.description}</p>
  <TagList lang={lang} tags={post.data.tags} />
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(20px, 3vw, 30px);
  }

  h2 {
    margin: 0;
    font-size: clamp(1.3rem, 2.3vw, 1.65rem);
    text-wrap: pretty;
  }

  h2 a {
    color: var(--ink-strong);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--blue);
  }

  .description {
    margin: 0;
  }
</style>
