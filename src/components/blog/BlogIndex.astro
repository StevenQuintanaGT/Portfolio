---
// The blog list, used by /blog and by each /blog/tags/<tag> page
import Base from '../../layouts/Base.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import Icon from '../Icon.astro';
import PostCard from './PostCard.astro';
import { blogUrl, getPosts, getTags, tagSlug, tagUrl } from '../../lib/blog';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  // When set, only posts with this tag (by slug) are listed
  tag?: string;
}

const { lang, tag } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'en' ? 'es' : 'en';

const allPosts = await getPosts();
const tags = getTags(allPosts);
const posts = tag ? allPosts.filter((post) => post.data.tags.some((tg) => tagSlug(tg) === tag)) : allPosts;
const tagName = tag ? tags.find(([slug]) => slug === tag)?.[1] : undefined;

const path = (l: Lang) => (tagName ? tagUrl(l, tagName) : blogUrl(l));
const title = tagName ? `#${tagName} — ${t('blog.metaTitle')}` : t('blog.metaTitle');
const description = tagName ? `${t('blog.tagTitle')} #${tagName}. ${t('blog.description')}` : t('blog.description');
---

<Base
  lang={lang}
  title={title}
  description={description}
  alternates={{ en: path('en'), es: path('es') }}
  ogImage={`/og/blog-${lang}.png`}
>
  <Nav lang={lang} switchUrl={path(otherLang)} />
  <main>
    <section class="section">
      <div class="container">
        <header class="blog-header">
          <div class="header-copy">
            <p class="eyebrow" aria-hidden="true">
              <span class="prompt">$</span> {tagName ? `ls ~/blog --tag=${tagName}` : 'ls ~/blog'}
            </p>
            <h1>{tagName ? `#${tagName}` : t('nav.blog')}</h1>
            {!tagName && <p class="intro">{t('blog.intro')}</p>}
          </div>
          <a class="btn btn-sm rss-btn" href="/rss.xml">
            <Icon name="rss" size={14} />
            {t('blog.rss')}
          </a>
        </header>

        {
          tags.length > 0 && (
            <nav class="filters" aria-label={t('blog.tags')}>
              <ul class="tag-list">
                <li>
                  <a class="tag filter" href={blogUrl(lang)} aria-current={!tag ? 'page' : undefined}>
                    {t('blog.allPosts')}
                  </a>
                </li>
                {tags.map(([slug, name]) => (
                  <li>
                    <a class="tag filter" href={tagUrl(lang, name)} aria-current={slug === tag ? 'page' : undefined}>
                      #{name}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        {
          posts.length > 0 ? (
            <div class="list">
              {posts.map((post) => (
                <PostCard lang={lang} post={post} />
              ))}
            </div>
          ) : (
            <p class="empty">{t('blog.empty')}</p>
          )
        }
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .blog-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 30px;
    padding-bottom: 26px;
    border-bottom: 1px solid var(--line);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 12px;
    padding: 3px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(10 15 25 / 0.72);
    color: var(--accent-2);
    font: 0.75rem/1.4 var(--font-mono);
  }

  h1 {
    margin: 0 0 10px;
    font-size: clamp(2.5rem, 6.5vw, 4.75rem);
    letter-spacing: -0.055em;
    overflow-wrap: anywhere;
  }

  .intro {
    margin: 0;
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    color: var(--ink);
  }

  .rss-btn {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .rss-btn :global(.icon-svg) {
    color: var(--accent-2);
  }

  .filters {
    margin-bottom: 32px;
  }

  .filter {
    border-radius: 999px;
    padding: 5px 12px;
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .filter:hover {
    border-color: rgb(167 139 250 / 0.45);
    color: var(--ink-strong);
  }

  .filter[aria-current='page'] {
    border-color: rgb(167 139 250 / 0.4);
    background: rgb(167 139 250 / 0.14);
    color: var(--ink-strong);
  }

  .list {
    display: grid;
    gap: 18px;
  }

  @media (min-width: 760px) {
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .empty {
    padding: 28px;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-lg);
    background: rgb(10 15 25 / 0.5);
    font-family: var(--font-mono);
    max-width: none;
  }
</style>
