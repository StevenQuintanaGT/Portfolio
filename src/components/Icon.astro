---

<svg
  class:list={['icon-svg', className]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]} />
</svg>

<style>
  .icon-svg {
    flex: none;
    display: inline-block;
    vertical-align: middle;
  }
</style>
