---
import SectionTitle from './SectionTitle.astro';
import { skills, useTranslations, type Lang } from '../i18n/ui';
import { getPosts, postUrl } from '../lib/blog';
import { getProjects, projectAnchor } from '../lib/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const [projects, posts] = await Promise.all([getProjects(lang), getPosts()]);
const dnsGuide = posts.find((post) => post.id === 'configure-router-dns');

function projectLink(slug: string) {
  const project = projects.find(({ id }) => id === `${lang}/${slug}`);
  return project && { href: `#${projectAnchor(project.id)}`, title: project.data.title };
}

// Simple line icons (24×24, stroke = currentColor)
const icons = {
  shield: 'M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z M9 12l2 2 4-4',
  server: 'M4 4h16v6H4z M4 14h16v6H4z M8 7h.01 M8 17h.01',
  cloud: 'M7 18h10a4 4 0 0 0 .4-8A6 6 0 0 0 6 9.5 4.3 4.3 0 0 0 7 18z',
};

const groups = [
  {
    title: t('skills.security'),
    items: [...skills.security, t('skills.ipv4')],
    icon: icons.shield,
    related: dnsGuide && { href: postUrl(lang, dnsGuide), title: t('skills.dnsGuide') },
  },
  { title: t('skills.systems'), items: skills.systems, icon: icons.server, related: projectLink('hypr-dotfiles') },
  { title: t('skills.cloud'), items: skills.cloud, icon: icons.cloud, related: projectLink('domain-email') },
];
---

<section id="skills" class="section">
  <div class="container">
    <SectionTitle title={t('skills.heading')} />
    <div class="grid">
      {
        groups.map((group) => (
          <div class="panel skill-card" data-reveal data-reactive>
            <div class="head">
              <span class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d={group.icon} />
                </svg>
              </span>
              <h3>{group.title}</h3>
            </div>
            <ul class="tag-list">
              {group.items.map((item) => (
                <li class="tag">{item}</li>
              ))}
            </ul>
            {group.related && (
              <div class="related">
                <a href={group.related.href}>{group.related.title}</a>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 14px;
  }

  @media (min-width: 800px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .skill-card:nth-child(2) { --reveal-delay: 90ms; }
    .skill-card:nth-child(3) { --reveal-delay: 180ms; }
  }

  .skill-card {
    display: flex;
    flex-direction: column;
    padding: clamp(18px, 2.5vw, 28px);
  }

  .head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex: none;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .icon { transition: transform 0.3s var(--ease-out); }

    :global(html[data-motion='playing']) .skill-card:is(:hover, :focus-within) .icon {
      transform: translateY(-3px) rotate(-8deg);
    }
  }

  .related {
    margin-top: auto;
    padding-top: 18px;
  }

  .related a {
    display: block;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .related a:hover { color: var(--ink-strong); }

  h3 {
    margin: 0;
    font-size: 1.15rem;
  }
</style>
