---
import SectionTitle from './SectionTitle.astro';
import { skills, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Simple line icons (24×24, stroke = currentColor)
const icons = {
  shield: 'M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z M9 12l2 2 4-4',
  server: 'M4 4h16v6H4z M4 14h16v6H4z M8 7h.01 M8 17h.01',
  cloud: 'M7 18h10a4 4 0 0 0 .4-8A6 6 0 0 0 6 9.5 4.3 4.3 0 0 0 7 18z',
};

const groups = [
  { title: t('skills.security'), items: skills.security, icon: icons.shield },
  { title: t('skills.systems'), items: skills.systems, icon: icons.server },
  { title: t('skills.cloud'), items: skills.cloud, icon: icons.cloud },
];
---

<section id="skills" class="section">
  <div class="container">
    <SectionTitle index="02" text={t('skills.title')} title={t('skills.heading')} />
    <div class="grid">
      {
        groups.map((group) => (
          <div class="card hover-lift">
            <div class="head">
              <span class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d={group.icon} />
                </svg>
              </span>
              <h3>{group.title}</h3>
            </div>
            <ul class="chips">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }

  .card {
    padding: 28px;
    border: 1px solid var(--card-border, var(--line));
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border: 1px solid rgba(167, 139, 250, 0.3);
    border-radius: 12px;
    background: rgba(167, 139, 250, 0.1);
    color: var(--accent);
  }

  h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    color: var(--ink-strong);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
</style>
