---
import Icon, { type IconName } from './Icon.astro';
import SectionTitle from './SectionTitle.astro';
import { skills, useTranslations, type Lang } from '../i18n/ui';
import { getPosts, postUrl } from '../lib/blog';
import { getProjects, projectAnchor } from '../lib/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const [projects, posts] = await Promise.all([getProjects(lang), getPosts()]);
const dnsGuide = posts.find((post) => post.id === 'configure-router-dns');

function projectLink(slug: string) {
  const project = projects.find(({ id }) => id === `${lang}/${slug}`);
  return project && { href: `#${projectAnchor(project.id)}`, title: project.data.title };
}

const groups: {
  id: 'security' | 'systems' | 'cloud';
  title: string;
  items: readonly string[];
  icon: IconName;
  related?: { href: string; title: string };
}[] = [
  {
    id: 'security',
    title: t('skills.security'),
    items: [...skills.security, t('skills.ipv4')],
    icon: 'shield',
    related: dnsGuide && { href: postUrl(lang, dnsGuide), title: t('skills.dnsGuide') },
  },
  { id: 'systems', title: t('skills.systems'), items: skills.systems, icon: 'server', related: projectLink('hypr-dotfiles') },
  { id: 'cloud', title: t('skills.cloud'), items: skills.cloud, icon: 'cloud', related: projectLink('domain-email') },
];
---

<section id="skills" class="section">
  <div class="container">
    <SectionTitle title={t('skills.heading')} eyebrow="which --all" />
    <div class="grid">
      {
        groups.map((group) => (
          <div class:list={['panel skill-card', `tone-${group.id}`]} data-reveal data-reactive>
            <div class="head">
              <span class="icon" aria-hidden="true">
                <Icon name={group.icon} size={20} />
              </span>
              <h3>{group.title}</h3>
            </div>
            <ul class="tag-list">
              {group.items.map((item) => (
                <li class="tag">{item}</li>
              ))}
            </ul>
            {group.related && (
              <div class="related">
                <a href={group.related.href}>
                  <span>{group.related.title}</span>
                  <Icon name="arrow-right" size={15} class="arrow" />
                </a>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 820px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .skill-card:nth-child(2) { --reveal-delay: 90ms; }
    .skill-card:nth-child(3) { --reveal-delay: 180ms; }
  }

  .skill-card {
    --card-accent: var(--accent);
    display: flex;
    flex-direction: column;
    padding: clamp(20px, 2.5vw, 28px);
    border-top-color: color-mix(in srgb, var(--card-accent) 34%, transparent);
  }

  .tone-systems {
    --card-accent: var(--accent-2);
  }

  .tone-cloud {
    --card-accent: #9de8c4;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border: 1px solid color-mix(in srgb, var(--card-accent) 30%, transparent);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--card-accent) 11%, var(--surface-deep));
    color: var(--card-accent);
  }

  .related {
    margin-top: auto;
    padding-top: 22px;
  }

  .related a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 11px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: rgb(10 15 25 / 0.6);
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .related a :global(.arrow) {
    color: var(--card-accent);
    transition: transform 0.22s var(--ease-out);
  }

  .related a:hover {
    border-color: color-mix(in srgb, var(--card-accent) 45%, transparent);
    background: color-mix(in srgb, var(--card-accent) 9%, var(--surface-deep));
    color: var(--ink-strong);
  }

  @media (prefers-reduced-motion: no-preference) {
    .icon { transition: transform 0.3s var(--ease-out); }

    :global(html[data-motion='playing']) .skill-card:is(:hover, :focus-within) .icon {
      transform: translateY(-3px) rotate(-6deg);
    }

    .related a:hover :global(.arrow) {
      transform: translateX(3px);
    }
  }

  h3 {
    margin: 0;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
</style>
