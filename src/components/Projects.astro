---
import SectionTitle from './SectionTitle.astro';
import ProjectCard from './ProjectCard.astro';
import { getProjects, projectAnchor } from '../lib/projects';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = await getProjects(lang);
---

<section id="projects" class="section">
  <div class="container">
    <SectionTitle title={t('projects.heading')} eyebrow="ls ~/projects" />
    {projects.length > 1 && (
      <nav class="project-jumps" data-project-jumps aria-label={t('projects.jump')} data-reveal>
        {projects.map(({ id, data }, i) => (
          <a href={`#${projectAnchor(id)}`}>
            <span class="jump-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            {data.title}
          </a>
        ))}
      </nav>
    )}
    <div class="grid">
      {
        projects.map((project, i) => (
          <ProjectCard
            lang={lang}
            projectId={project.id}
            index={i + 1}
            {...project.data}
            featured={i === 0}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  const jumps = document.querySelectorAll<HTMLAnchorElement>('[data-project-jumps] a');
  if (jumps.length) {
    const markSelection = () => {
      for (const link of jumps) {
        if (link.hash === location.hash) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    };
    markSelection();
    window.addEventListener('hashchange', markSelection);
  }
</script>

<style>
  .project-jumps {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
  }

  .project-jumps a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 5px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(10 15 25 / 0.8);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .jump-index {
    color: var(--accent-2);
    font: 0.75rem/1 var(--font-mono);
    opacity: 0.85;
  }

  .project-jumps a:hover,
  .project-jumps a[aria-current] {
    border-color: rgb(192 175 252 / 0.42);
    background: rgb(192 175 252 / 0.12);
    color: var(--ink-strong);
  }

  .grid {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 760px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
