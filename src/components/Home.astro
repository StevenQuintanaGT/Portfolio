---
// The full one-page site. Each language page renders this with its own `lang`.
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Skills from './Skills.astro';
import Projects from './Projects.astro';
import Certifications from './Certifications.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import { site } from '../config';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Structured data: tells Google this site is about the person "Steven Quintana"
// and links it to the same person's GitHub and LinkedIn profiles.
const siteUrl = new URL('/', Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: site.name,
      url: siteUrl,
      email: `mailto:${site.email}`,
      jobTitle: t('hero.role'),
      description: t('meta.description'),
      knowsAbout: ['Cybersecurity', 'Networking', 'Infrastructure', 'Cloud', 'Linux', 'Windows Server'],
      affiliation: { '@type': 'CollegeOrUniversity', name: 'Universidad Mariano Gálvez de Guatemala' },
      address: { '@type': 'PostalAddress', addressCountry: 'GT' },
      sameAs: [site.github, site.linkedin],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: site.name,
      url: siteUrl,
      inLanguage: ['en', 'es'],
      publisher: { '@id': `${siteUrl}#person` },
    },
  ],
};
---

<Base lang={lang}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
  <Nav lang={lang} />
  <main>
    <Hero lang={lang} />
    <About lang={lang} />
    <Skills lang={lang} />
    <Projects lang={lang} />
    <Certifications lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
