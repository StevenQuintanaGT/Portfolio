---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  problem: string;
  result: string;
  tools: string[];
  repo?: string;
  demo?: string;
  // Position in the list, e.g. "01"
  index: string;
  // The first project gets a wide card
  featured?: boolean;
}

const { lang, title, problem, result, tools, repo, demo, index, featured = false } = Astro.props;
const t = useTranslations(lang);
---

<article class:list={['card hover-lift', { featured }]}>
  <div class="top">
    <span class="num">{index}</span>
    {featured && <span class="badge">{t('projects.featured')}</span>}
  </div>
  <h3>{title}</h3>
  <dl>
    <div>
      <dt>{t('projects.problem')}</dt>
      <dd>{problem}</dd>
    </div>
    <div>
      <dt>{t('projects.result')}</dt>
      <dd>{result}</dd>
    </div>
  </dl>
  <p class="visually-hidden">{t('projects.tools')}</p>
  <ul class="tag-list">
    {tools.map((tool) => <li class="tag">{tool}</li>)}
  </ul>
  {
    (repo || demo) && (
      <div class="links">
        {demo && (
          <a class="btn btn-primary btn-sm" href={demo} target="_blank" rel="noopener noreferrer">
            {t('projects.demo')} ↗
          </a>
        )}
        {repo && (
          <a class="btn btn-sm" href={repo} target="_blank" rel="noopener noreferrer">
            {t('projects.repo')} ↗
          </a>
        )}
      </div>
    )
  }
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 28px;
    border: 1px solid var(--card-border, var(--line));
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .num {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(167, 139, 250, 0.55);
  }

  .badge {
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--grad);
    color: #0a0b10;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
  }

  h3 {
    margin: 0;
    font-size: 1.35rem;
  }

  dl {
    display: grid;
    gap: 14px;
    margin: 0;
  }

  dt {
    margin-bottom: 4px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent-2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  dd {
    margin: 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: auto;
  }

  /* Featured: full width, bigger title, problem and result side by side */
  .featured {
    background:
      radial-gradient(500px 260px at 100% 0%, rgba(34, 211, 238, 0.1), transparent 70%),
      radial-gradient(500px 260px at 0% 100%, rgba(167, 139, 250, 0.12), transparent 70%),
      var(--surface);
  }

  @media (min-width: 760px) {
    .featured {
      grid-column: 1 / -1;
      padding: 36px;
    }

    .featured h3 {
      font-size: 1.9rem;
    }

    .featured dl {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }
</style>
