---
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { blogUrl } from '../lib/blog';
import { projectAnchor } from '../lib/projects';

interface Props {
  lang: Lang;
  projectId: string;
  index?: number;
  title: string;
  category?: string;
  cover?: string;
  highlights?: { title: string; detail: string }[];
  problem: string;
  result: string;
  tools: string[];
  repo?: string;
  demo?: string;
  article?: string;
  featured?: boolean;
}

const {
  lang,
  projectId,
  index,
  title,
  category,
  cover,
  highlights,
  problem,
  result,
  tools,
  repo,
  demo,
  article,
  featured = false,
} = Astro.props;
const t = useTranslations(lang);
const num = index ? String(index).padStart(2, '0') : undefined;
const articleHref = article ? blogUrl(lang, `${article}/`) : undefined;
---

<article id={projectAnchor(projectId)} class:list={['panel project', { featured, 'with-cover': cover }]} data-reveal data-reactive>
  <div class="content">
    <div class="header">
      <div class="meta-row">
        {num && <span class="project-num" aria-hidden="true">{num}</span>}
        {category && <p class="category">{category}</p>}
      </div>
      <h3>{title}</h3>
    </div>

    {highlights ? (
      <>
        <div class="description">
          <p>{problem}</p>
        </div>
        <div class="highlights">
          {highlights.map(({ title, detail }, idx) => (
            <details name={`${projectId}-highlights`} open={idx === 0}>
              <summary>{title}<span aria-hidden="true"></span></summary>
              <p>{detail}</p>
            </details>
          ))}
        </div>
      </>
    ) : (
      <div class="case-grid">
        <div class="case-block">
          <span class="case-label">{t('projects.problem')}</span>
          <p>{problem}</p>
        </div>
        <div class="case-block case-outcome">
          <span class="case-label">{t('projects.result')}</span>
          <p>{result}</p>
        </div>
      </div>
    )}

    <div class="card-footer">
      <ul class="tag-list" aria-label={t('projects.tools')}>
        {tools.map((tool) => <li class="tag">{tool}</li>)}
      </ul>
      {(repo || demo || articleHref) && (
        <div class="actions">
          {demo && (
            <a class="btn btn-primary btn-sm" href={demo} target="_blank" rel="noopener noreferrer">
              {t('projects.demo')}
              <Icon name="arrow-up-right" size={15} />
            </a>
          )}
          {articleHref && (
            <a class:list={['btn btn-sm', { 'btn-primary': !demo }]} href={articleHref}>
              {t('projects.article')}
              <Icon name="arrow-right" size={15} />
            </a>
          )}
          {repo && (
            <a class="btn btn-sm" href={repo} target="_blank" rel="noopener noreferrer">
              <Icon name="github" size={15} />
              {t('projects.repo')}
            </a>
          )}
        </div>
      )}
    </div>
  </div>
  {cover && (
    <div class="cover">
      <img src={cover} alt="" loading="lazy" decoding="async" />
    </div>
  )}
</article>

<style>
  .project {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    border-radius: var(--radius-xl);
  }

  .project:nth-child(3) {
    --reveal-delay: 90ms;
  }

  .project:target {
    border-color: rgb(167 139 250 / 0.55);
    box-shadow: 0 0 32px rgb(167 139 250 / 0.16);
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: clamp(22px, 3vw, 34px);
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .project-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 2px 8px;
    border: 1px solid rgb(167 139 250 / 0.25);
    border-radius: 999px;
    background: rgb(167 139 250 / 0.09);
    color: var(--accent);
    font: 0.75rem/1.4 var(--font-mono);
  }

  .category {
    margin: 0;
    padding: 2px 10px;
    border: 1px solid rgb(34 211 238 / 0.24);
    border-radius: 999px;
    background: rgb(34 211 238 / 0.08);
    color: var(--accent-2);
    font: 0.75rem/1.5 var(--font-mono);
  }

  h3 {
    margin: 0;
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    letter-spacing: -0.03em;
  }

  .featured h3 {
    font-size: clamp(1.9rem, 3.8vw, 2.75rem);
    letter-spacing: -0.05em;
  }

  .featured {
    border-color: rgb(167 139 250 / 0.28);
    background:
      radial-gradient(ellipse 65% 55% at 10% 0%, rgb(178 149 252 / 0.12), transparent 68%),
      var(--panel-fill);
  }

  .description p {
    margin: 0;
    color: var(--ink);
    font-size: 1rem;
  }

  .case-grid {
    display: grid;
    gap: 14px;
  }

  .case-block {
    display: grid;
    gap: 5px;
  }

  .case-block p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.62;
  }

  .case-label {
    color: var(--ink-muted);
    font: 0.72rem/1.4 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .case-outcome {
    padding: 12px 14px;
    border: 1px solid rgb(167 139 250 / 0.14);
    border-inline-start: 2px solid var(--accent-2);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background: rgb(10 15 25 / 0.65);
  }

  .case-outcome .case-label {
    color: var(--accent-2);
  }

  .case-outcome p {
    color: #d6dfee;
  }

  .highlights {
    border-block: 1px solid var(--line);
  }

  .highlights details {
    transition: background-color 0.2s ease;
  }

  .highlights details + details {
    border-top: 1px solid var(--line);
  }

  .highlights details[open] {
    background: rgb(167 139 250 / 0.045);
  }

  .highlights summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    gap: 10px;
    color: var(--ink-strong);
    font-size: 0.9375rem;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
    transition: box-shadow 0.25s ease, color 0.25s ease, padding-inline 0.25s ease;
  }

  .highlights summary::-webkit-details-marker {
    display: none;
  }

  .highlights summary:hover,
  .highlights details[open] summary {
    color: var(--accent);
  }

  .highlights details[open] summary {
    padding-inline: 12px;
    box-shadow: inset 2px 0 var(--accent);
  }

  .highlights summary span {
    position: relative;
    flex: 0 0 10px;
    height: 1px;
    background: currentColor;
  }

  .highlights summary span::after {
    position: absolute;
    inset: 0;
    content: '';
    background: currentColor;
    transform: rotate(90deg);
    transition: transform 0.24s ease;
  }

  .highlights details[open] summary span::after { transform: none; }

  .highlights p {
    margin: 0 12px 14px;
    font-size: 0.9375rem;
  }

  .card-footer {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .cover {
    position: relative;
    order: -1;
    width: 100%;
    min-height: 190px;
    aspect-ratio: 2.05;
    background: var(--surface-raised);
    overflow: hidden;
  }

  .cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% 50%;
  }

  .cover::after {
    position: absolute;
    inset: 0;
    content: '';
    background: linear-gradient(135deg, rgb(109 89 164 / 0.16), transparent 50%, rgb(7 10 18 / 0.42));
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-motion='playing']) .project:target {
      animation: targeted 0.7s var(--ease-out);
    }

    .highlights details[open] p {
      animation: open-highlight 0.29s ease-out;
    }

    .cover img {
      transition: transform 0.48s var(--ease-out);
    }

    .project:focus-within .cover img {
      transform: scale(1.045);
    }

    @media (hover: hover) and (pointer: fine) {
      .project:hover .cover img {
        transform: translate(var(--pan-x, 0px), var(--pan-y, 0px)) scale(1.06);
      }
    }
  }

  @keyframes open-highlight {
    from { opacity: 0.3; transform: translateY(-4px); }
  }

  @keyframes targeted {
    from { box-shadow: 0 0 0 3px rgb(167 139 250 / 0.26), 0 0 32px rgb(167 139 250 / 0.2); }
  }

  @media (min-width: 760px) {
    .featured,
    .project:not(.featured):last-child:nth-child(even) {
      grid-column: 1 / -1;
    }

    .featured.with-cover {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }

    .featured .cover {
      order: 0;
      aspect-ratio: auto;
      min-height: 0;
      border-inline-start: 1px solid var(--line);
    }
  }
</style>
